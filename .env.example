# IBM Quantum credentials
IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here

# D-Wave credentials
DWAVE_API_TOKEN=your_dwave_api_token_here

# Azure Quantum credentials
AZURE_QUANTUM_SUBSCRIPTION_ID=your_subscription_id
AZURE_QUANTUM_RESOURCE_GROUP=your_resource_group
AZURE_QUANTUM_WORKSPACE=your_workspace_name

# Optional overrides (QA_ prefix convention)
# QA_BACKEND__USE_SIMULATOR=true
# QA_BACKEND__BACKEND_NAME=ibm_brisbane
# QA_LOGGING__LEVEL=DEBUG
